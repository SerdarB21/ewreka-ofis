{
  "name": "ewreka-ofis",
  "productName": "Ewreka Ofis",
  "version": "1.0.0",
  "description": "Ewreka Ofis — Nota, Matrix, Vista ve Carta: ücretsiz, açık kaynak ofis paketi",
  "main": "main/main.js",
  "author": {
    "name": "Ewreka Digital",
    "url": "https://www.ewreka.net"
  },
  "homepage": "https://www.ewreka.net",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.ewreka.ofis",
    "productName": "Ewreka Ofis",
    "copyright": "Copyright © 2026 Ewreka Digital",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "launcher/**",
      "shared/**",
      "modules/**",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!**/tests/**",
      "!test-files/**",
      "!MODULE_BRIEF.md"
    ],
    "extraResources": [
      {
        "from": "build/res-icons",
        "to": "icons"
      },
      {
        "from": "build/lisanslar",
        "to": "lisanslar"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Ewreka Nota Belgesi",
        "description": "Word belgesi",
        "icon": "icons/nota",
        "role": "Editor"
      },
      {
        "ext": "xlsx",
        "name": "Ewreka Matrix Tablosu",
        "description": "Excel çalışma kitabı",
        "icon": "icons/matrix",
        "role": "Editor"
      },
      {
        "ext": "xlsm",
        "name": "Ewreka Matrix Tablosu (makrolu)",
        "description": "Excel çalışma kitabı",
        "icon": "icons/matrix",
        "role": "Editor"
      },
      {
        "ext": "csv",
        "name": "CSV Dosyası",
        "description": "Virgülle ayrılmış değerler",
        "icon": "icons/matrix",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "Ewreka Vista Sunusu",
        "description": "PowerPoint sunusu",
        "icon": "icons/vista",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "Ewreka Carta PDF",
        "description": "PDF belgesi",
        "icon": "icons/carta",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/app.ico",
      "legalTrademarks": "Ewreka Digital",
      "signAndEditExecutable": true,
      "executableName": "EwrekaOfis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ewreka Ofis",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "license": "build/license_tr.txt",
      "include": "build/installer.nsh",
      "installerIcon": "icons/app.ico",
      "uninstallerIcon": "icons/app.ico",
      "installerHeaderIcon": "icons/app.ico",
      "uninstallDisplayName": "Ewreka Ofis",
      "artifactName": "EwrekaOfis-Kurulum-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "unicode": true
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icons/app.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "EwrekaOfis-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDevelopmentRegion": "tr",
        "LSMultipleInstancesProhibited": true
      }
    },
    "electronLanguages": [
      "tr",
      "en-US",
      "en"
    ],
    "publish": null
  }
}